+import assert from 'node:assert/strict'
+
+import { test } from 'vitest'
+
+import {
+  COMMUNITY_CASK,
+  COMMUNITY_CASK_CONTENTS_API,
+  communityHomebrewConfig,
+  compareDottedVersions,
+  parseCaskContentsResponse,
+  pickHomebrewBinary,
+  runHomebrewUpdate,
+  verifiedInstalledCommunityVersion
+} from './community-homebrew-update'
+
+const stamp = {
+  distribution: 'frankhommers-homebrew',
+  distributionVersion: '0.17.2.1'
+}
+
+function caskPayload(source: string, overrides: Record<string, unknown> = {}) {
+  const raw = Buffer.from(source)
+
+  return { encoding: 'base64', type: 'file', size: raw.length, content: raw.toString('base64'), ...overrides }
+}
+
+test('only the packaged Frank Homebrew macOS distribution enables package updates', () => {
+  assert.deepEqual(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'darwin' }), {
+    currentVersion: '0.17.2.1',
+    cask: COMMUNITY_CASK,
+    contentsApi: COMMUNITY_CASK_CONTENTS_API
+  })
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: false, platform: 'darwin' }), null)
+  assert.equal(communityHomebrewConfig(stamp, { isPackaged: true, platform: 'linux' }), null)
+  assert.equal(
+    communityHomebrewConfig({ ...stamp, distribution: 'somebody-else' }, { isPackaged: true, platform: 'darwin' }),
+    null
+  )
+  assert.equal(
+    communityHomebrewConfig({ ...stamp, distributionVersion: '0.17.2.1; touch /tmp/pwn' }, { isPackaged: true, platform: 'darwin' }),
+    null
+  )
+})
+
+test('the tap payload yields only one strict version from the expected cask', () => {
+  const source = 'cask "hermes-desktop" do\n  version "0.17.2.3"\nend\n'
+  assert.equal(parseCaskContentsResponse(caskPayload(source)), '0.17.2.3')
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { content: '@@@' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { encoding: 'utf8' })))
+  assert.throws(() => parseCaskContentsResponse(caskPayload(source, { size: Buffer.byteLength(source) - 1 })))
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "somebody-else" do\n  version "0.17.2.3"\nend\n'))
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse(
+      caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3"\n  version "0.17.2.4"\nend\n')
+    )
+  )
+  assert.throws(() =>
+    parseCaskContentsResponse(caskPayload('cask "hermes-desktop" do\n  version "0.17.2.3; echo hi"\nend\n'))
+  )
+})
+
+test('compareDottedVersions orders 3- and 4-segment monotonic strings', () => {
+  assert.equal(compareDottedVersions('0.17.2.1', '0.17.2.1'), 0)
+  assert.equal(compareDottedVersions('0.17.2', '0.17.2.0'), 0)
+  assert.equal(compareDottedVersions('0.17.2.1', '0.17.2.2'), -1)
+  assert.equal(compareDottedVersions('0.17.3', '0.17.2.9'), 1)
+  assert.equal(compareDottedVersions('0.18.0.0', '0.17.9.9'), 1)
+})
+
+test('pickHomebrewBinary uses only canonical Apple Silicon and Intel paths', () => {
+  assert.equal(
+    pickHomebrewBinary(candidate => candidate === '/opt/homebrew/bin/brew'),
+    '/opt/homebrew/bin/brew'
+  )
+  assert.equal(
+    pickHomebrewBinary(candidate => candidate === '/usr/local/bin/brew'),
+    '/usr/local/bin/brew'
+  )
+  assert.equal(
+    pickHomebrewBinary(candidate => candidate === '/tmp/brew'),
+    null
+  )
+})
+
+test('verifiedInstalledCommunityVersion proves a newer version landed at the running path', () => {
+  assert.equal(
+    verifiedInstalledCommunityVersion(
+      '0.17.2.1',
+      '0.17.2.2',
+      { distribution: 'frankhommers-homebrew', distributionVersion: '0.17.2.2' },
+      { isPackaged: true, platform: 'darwin' }
+    ),
+    '0.17.2.2'
+  )
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion(
+      '0.17.2.1',
+      '0.17.2.2',
+      { distribution: 'frankhommers-homebrew', distributionVersion: '0.17.2.1' },
+      { isPackaged: true, platform: 'darwin' }
+    )
+  )
+  assert.throws(() =>
+    verifiedInstalledCommunityVersion(
+      '0.17.2.1',
+      '0.17.2.2',
+      { distribution: 'frankhommers-homebrew', distributionVersion: '0.17.2.0' },
+      { isPackaged: true, platform: 'darwin' }
+    )
+  )
+})
+
+test('runHomebrewUpdate passes exact arguments and fails closed on non-zero exit', async () => {
+  const calls: string[][] = []
+  const steps: string[] = []
+
+  await runHomebrewUpdate(
+    '/opt/homebrew/bin/brew',
+    async (_command, args) => {
+      calls.push(args)
+      return { code: 0, output: 'ok' }
+    },
+    step => steps.push(step)
+  )
+
+  assert.deepEqual(calls, [
+    ['update'],
+    ['upgrade', '--cask', 'frankhommers/tap/hermes-desktop']
+  ])
+  assert.deepEqual(steps, ['update', 'upgrade'])
+
+  await assert.rejects(
+    () =>
+      runHomebrewUpdate('/opt/homebrew/bin/brew', async (_command, args) => ({
+        code: args[0] === 'update' ? 1 : 0,
+        output: 'network failed'
+      })),
+    /Homebrew update failed.*network failed/
+  )
+})
