@@ -0,0 +1,191 @@
+export const COMMUNITY_DISTRIBUTION = 'frankhommers-homebrew'
+export const COMMUNITY_CASK = 'frankhommers/tap/hermes-desktop'
+export const COMMUNITY_CASK_CONTENTS_API =
+  'https://api.github.com/repos/frankhommers/homebrew-tap/contents/casks/hermes-desktop.rb?ref=main'
+
+const VERSION_SEGMENT_PATTERN = /^(?:0|[1-9]\d{0,8})$/
+const MAX_CASK_BYTES = 64 * 1024
+const HOMEBREW_BINARIES = ['/opt/homebrew/bin/brew', '/usr/local/bin/brew'] as const
+
+interface InstallStampLike {
+  distribution?: unknown
+  distributionVersion?: unknown
+}
+
+export interface CommunityHomebrewConfig {
+  currentVersion: string
+  cask: typeof COMMUNITY_CASK
+  contentsApi: typeof COMMUNITY_CASK_CONTENTS_API
+}
+
+export interface CommunityHomebrewRuntime {
+  isPackaged: boolean
+  platform: NodeJS.Platform | string
+}
+
+export function isDottedVersion(value: unknown): value is string {
+  if (typeof value !== 'string') return false
+  const segments = value.split('.')
+
+  return (
+    segments.length >= 3 &&
+    segments.length <= 4 &&
+    segments.every(segment => VERSION_SEGMENT_PATTERN.test(segment))
+  )
+}
+
+/** Enable this updater only for a stamped, packaged build from Frank's macOS tap. */
+export function communityHomebrewConfig(
+  stamp: InstallStampLike | null | undefined,
+  runtime: CommunityHomebrewRuntime
+): CommunityHomebrewConfig | null {
+  if (
+    !runtime.isPackaged ||
+    runtime.platform !== 'darwin' ||
+    stamp?.distribution !== COMMUNITY_DISTRIBUTION ||
+    !isDottedVersion(stamp.distributionVersion)
+  ) {
+    return null
+  }
+
+  return {
+    currentVersion: stamp.distributionVersion,
+    cask: COMMUNITY_CASK,
+    contentsApi: COMMUNITY_CASK_CONTENTS_API
+  }
+}
+
+export function compareDottedVersions(left: string, right: string): -1 | 0 | 1 {
+  if (!isDottedVersion(left) || !isDottedVersion(right)) {
+    throw new Error('Cannot compare a malformed desktop distribution version')
+  }
+
+  const a = left.split('.').map(Number)
+  const b = right.split('.').map(Number)
+  const length = Math.max(a.length, b.length)
+
+  for (let index = 0; index < length; index += 1) {
+    const difference = (a[index] ?? 0) - (b[index] ?? 0)
+    if (difference < 0) return -1
+    if (difference > 0) return 1
+  }
+
+  return 0
+}
+
+/** Parse GitHub's Contents API response without ever treating tap text as executable data. */
+export function parseCaskContentsResponse(payload: unknown): string {
+  if (!payload || typeof payload !== 'object') {
+    throw new Error('Homebrew tap response is not an object')
+  }
+
+  const response = payload as { content?: unknown; encoding?: unknown; size?: unknown; type?: unknown }
+  if (
+    response.type !== 'file' ||
+    response.encoding !== 'base64' ||
+    typeof response.content !== 'string' ||
+    typeof response.size !== 'number' ||
+    !Number.isInteger(response.size) ||
+    response.size < 1 ||
+    response.size > MAX_CASK_BYTES
+  ) {
+    throw new Error('Homebrew tap response has an invalid file envelope')
+  }
+
+  const compact = response.content.replace(/\s/g, '')
+  if (!compact || compact.length > Math.ceil(MAX_CASK_BYTES / 3) * 4 || !/^[A-Za-z0-9+/]+={0,2}$/.test(compact)) {
+    throw new Error('Homebrew tap response contains malformed base64')
+  }
+
+  const raw = Buffer.from(compact, 'base64')
+  if (raw.toString('base64') !== compact || raw.length !== response.size || raw.length > MAX_CASK_BYTES) {
+    throw new Error('Homebrew tap response size or encoding does not match its envelope')
+  }
+
+  let source: string
+  try {
+    source = new TextDecoder('utf-8', { fatal: true }).decode(raw)
+  } catch {
+    throw new Error('Homebrew cask source is not valid UTF-8')
+  }
+  if (!source || source.includes('\0')) {
+    throw new Error('Homebrew cask source is empty or invalid')
+  }
+
+  const casks = [...source.matchAll(/^\s*cask\s+"([^"]+)"\s+do\s*$/gm)]
+  if (casks.length !== 1 || casks[0]?.[1] !== 'hermes-desktop') {
+    throw new Error('Homebrew cask source has an unexpected identity')
+  }
+
+  const versions = [...source.matchAll(/^\s*version\s+"([^"]+)"\s*$/gm)]
+  const version = versions.length === 1 ? versions[0]?.[1] : undefined
+  if (!isDottedVersion(version)) {
+    throw new Error('Homebrew cask does not contain exactly one strict numeric version')
+  }
+
+  return version
+}
+
+/** GUI apps do not inherit shell PATH; accept only Homebrew's two standard macOS locations. */
+export function pickHomebrewBinary(isExecutable: (candidate: string) => boolean): string | null {
+  for (const candidate of HOMEBREW_BINARIES) {
+    if (isExecutable(candidate)) return candidate
+  }
+  return null
+}
+
+export interface HomebrewCommandResult {
+  code: number
+  output: string
+}
+
+/** Prove Homebrew replaced this running distribution before claiming success or relaunching. */
+export function verifiedInstalledCommunityVersion(
+  beforeVersion: string,
+  targetVersion: string,
+  installedStamp: InstallStampLike | null | undefined,
+  runtime: CommunityHomebrewRuntime
+): string {
+  const installed = communityHomebrewConfig(installedStamp, runtime)
+  if (!installed) {
+    throw new Error('Homebrew did not install a valid Hermes Desktop community bundle at the running app path')
+  }
+  if (
+    compareDottedVersions(installed.currentVersion, beforeVersion) <= 0 ||
+    compareDottedVersions(installed.currentVersion, targetVersion) < 0
+  ) {
+    throw new Error(
+      `Homebrew finished but the running app path still contains Hermes Desktop ${installed.currentVersion}; expected at least ${targetVersion}`
+    )
+  }
+
+  return installed.currentVersion
+}
+
+export type HomebrewCommandRunner = (command: string, args: string[]) => Promise<HomebrewCommandResult>
+
+function failureOutput(value: string): string {
+  const normalized = value.replace(/\u001b\[[0-9;]*m/g, '').trim()
+  return normalized.length > 2_000 ? normalized.slice(-2_000) : normalized
+}
+
+/** Fixed executable + argv only: no shell, no interpolation, and stop at the first failure. */
+export async function runHomebrewUpdate(
+  brew: string,
+  run: HomebrewCommandRunner,
+  onStep?: (step: 'update' | 'upgrade') => void
+): Promise<void> {
+  const steps: Array<{ name: 'update' | 'upgrade'; args: string[] }> = [
+    { name: 'update', args: ['update'] },
+    { name: 'upgrade', args: ['upgrade', '--cask', COMMUNITY_CASK] }
+  ]
+
+  for (const step of steps) {
+    onStep?.(step.name)
+    const result = await run(brew, step.args)
+    if (!Number.isInteger(result.code) || result.code !== 0) {
+      const detail = failureOutput(result.output)
+      throw new Error(`Homebrew ${step.name} failed (exit ${result.code})${detail ? `: ${detail}` : ''}`)
+    }
+  }
+}
