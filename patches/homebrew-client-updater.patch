+function runCommunityHomebrewCommand(command: string, args: string[]): Promise<HomebrewCommandResult> {
+  return new Promise<{ code: number; output: string }>(resolve => {
+    let output = ''
+    const append = (chunk: unknown) => {
+      output += Buffer.isBuffer(chunk) ? chunk.toString('utf8') : String(chunk ?? '')
+      if (output.length > 64_000) output = output.slice(-64_000)
+    }
+    const env: NodeJS.ProcessEnv = {
+      HOME: os.homedir(),
+      PATH: `${path.dirname(command)}:/usr/bin:/bin:/usr/sbin:/sbin`,
+      HOMEBREW_NO_ANALYTICS: '1',
+      HOMEBREW_NO_AUTO_UPDATE: '1',
+      HOMEBREW_NO_ENV_HINTS: '1'
+    }
+
+    for (const name of ['USER', 'LOGNAME', 'TMPDIR', 'LANG', 'LC_ALL', 'HTTP_PROXY', 'HTTPS_PROXY', 'NO_PROXY']) {
+      if (process.env[name]) env[name] = process.env[name]
+    }
+
+    let child
+    try {
+      child = spawn(command, args, { cwd: os.homedir(), env, stdio: ['ignore', 'pipe', 'pipe'] })
+    } catch (error: any) {
+      resolve({ code: -1, output: error?.message || String(error) })
+      return
+    }
+
+    child.stdout?.on('data', append)
+    child.stderr?.on('data', append)
+    child.on('error', (error: any) => resolve({ code: -1, output: error?.message || String(error) }))
+    child.on('close', code => resolve({ code: typeof code === 'number' ? code : -1, output }))
+  })
+}
