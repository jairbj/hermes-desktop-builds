+  const currentSha = `homebrew:${config.currentVersion}`
+  const cached = readCommunityUpdateCheckCache()
+  const now = Date.now()
+
+  if (
+    !force &&
+    cached &&
+    cached.branch === branch &&
+    cached.currentSha === currentSha &&
+    now - cached.fetchedAt <
+      (cached.status?.error ? COMMUNITY_UPDATE_CHECK_FAILURE_TTL_MS : COMMUNITY_UPDATE_CHECK_TTL_MS)
+  ) {
+    return cached.status
+  }
+
+  let status: Partial<UpdaterStatusWire>
+  try {
+    const targetVersion = parseCaskContentsResponse(await fetchGitHubContentsApi(config.contentsApi))
+    const comparison = compareDottedVersions(config.currentVersion, targetVersion)
+    status = {
+      updateAvailable: comparison < 0,
+      behind: comparison < 0 ? null : 0,
+      targetSha: `homebrew:${targetVersion}`,
+      latestTag: targetVersion,
+      commits: []
+    }
+  } catch (error) {
+    status = { error: 'fetch-failed', message: error instanceof Error ? error.message : String(error) }
+  }
+
+  const result: UpdaterStatusWire = {
+    supported: true,
+    mechanism: 'manual',
+    branch,
+    currentBranch: branch,
+    currentSha,
+    currentVersion: config.currentVersion,
+    dirty: false,
+    hermesRoot: app.getAppPath(),
+    fetchedAt: now,
+    ...status
+  }
+  writeCommunityUpdateCheckCache({ fetchedAt: now, currentSha, branch, status: result })
+
+  return result
+}
